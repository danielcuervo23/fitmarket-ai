# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
# Both values are PUBLIC by design (they ship in the browser bundle); the data
# is protected by Row Level Security in Supabase, never by hiding these keys.
# Never put a service-role key or an OpenAI key here: those live only in
# Supabase secrets (see README).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: "true" shows the unfinished AI chat screen (/app/chat). Leave it
# off for production and store builds.
# VITE_FEATURE_CHAT=true
# Optional: base URL that password-reset e-mails link back to (the app adds
# "/reset-password"). Defaults to the site the user is on. Set it when the
# e-mail must open a different address, e.g. the native app's link (FIX-07).
# It must also be listed in Supabase -> Authentication -> URL Configuration
# -> Redirect URLs.
# VITE_AUTH_REDIRECT_URL=https://fitmarket-ai.vercel.app
